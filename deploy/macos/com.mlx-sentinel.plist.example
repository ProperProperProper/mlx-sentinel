<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.mlx-sentinel</string>
  <key>ProgramArguments</key><array><string>/bin/zsh</string><string>/ABSOLUTE/PATH/TO/start_mlx_sentinel.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>EnvironmentVariables</key><dict>
    <key>MLX_SENTINEL_MODE</key><string>guard</string>
    <key>MLX_SENTINEL_MAX_LOAD</key><string>0</string>
  </dict>
</dict></plist>
